diff --git a/apps/oxfmt/test/cli/astro.test.ts b/apps/oxfmt/test/cli/astro.test.ts
new file mode 100644
index 0000000000000000000000000000000000000000..67dcdb3e2f713319facc7b1c7fb29f418d95f533
--- /dev/null
+++ b/apps/oxfmt/test/cli/astro.test.ts
@@ -0,0 +1,104 @@
+import { mkdtemp, readFile, rm, writeFile } from "node:fs/promises";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { execa } from "execa";
+import { describe, expect, it } from "vitest";
+
+const astroCliPath = join(import.meta.dirname, "../../dist/cli.js");
+const astroInput = '<div   class = "x">Hello</div>';
+const astroOutput = '<div class="x">Hello</div>\n';
+
+describe("Astro CLI formatting", () => {
+  it("migrates the Astro plugin and preserves its formatting options", async () => {
+    const directory = await mkdtemp(join(tmpdir(), "oxfmt-astro-"));
+    try {
+      await writeFile(
+        join(directory, ".prettierrc.json"),
+        JSON.stringify({
+          plugins: ["prettier-plugin-astro"],
+          astroAllowShorthand: true,
+          astroSkipFrontmatter: true,
+          astroCompressHTML: "html",
+        }),
+      );
+      const result = await execa("node", [astroCliPath, "--migrate=prettier"], { cwd: directory });
+      expect(result.stderr).not.toContain("prettier-plugin-astro");
+      const config = JSON.parse(await readFile(join(directory, ".oxfmtrc.json"), "utf8"));
+      expect(config).toMatchObject({
+        printWidth: 80,
+        astroAllowShorthand: true,
+        astroSkipFrontmatter: true,
+        astroCompressHTML: "html",
+      });
+      expect(config).not.toHaveProperty("plugins");
+    } finally {
+      await rm(directory, { recursive: true, force: true });
+    }
+  });
+
+  it("checks and writes Astro files found by directory traversal", async () => {
+    const directory = await mkdtemp(join(tmpdir(), "oxfmt-astro-"));
+    try {
+      await writeFile(join(directory, "page.astro"), astroInput);
+      const check = await execa("node", [astroCliPath, "--check", "."], {
+        cwd: directory,
+        reject: false,
+      });
+      expect(check.exitCode).toBe(1);
+      expect(await readFile(join(directory, "page.astro"), "utf8")).toBe(astroInput);
+      await execa("node", [astroCliPath, "--write", "."], { cwd: directory });
+      expect(await readFile(join(directory, "page.astro"), "utf8")).toBe(astroOutput);
+      await execa("node", [astroCliPath, "--check", "."], { cwd: directory });
+    } finally {
+      await rm(directory, { recursive: true, force: true });
+    }
+  });
+
+  it("formats Astro from stdin", async () => {
+    const directory = await mkdtemp(join(tmpdir(), "oxfmt-astro-"));
+    try {
+      const result = await execa("node", [astroCliPath, "--stdin-filepath=page.astro"], {
+        cwd: directory,
+        input: astroInput,
+      });
+      expect(result.stdout).toBe(astroOutput.trimEnd());
+    } finally {
+      await rm(directory, { recursive: true, force: true });
+    }
+  });
+
+  it("applies Astro options through config overrides", async () => {
+    const directory = await mkdtemp(join(tmpdir(), "oxfmt-astro-"));
+    try {
+      await writeFile(
+        join(directory, ".oxfmtrc.json"),
+        JSON.stringify({
+          astroAllowShorthand: false,
+          overrides: [{ files: ["*.astro"], options: { astroAllowShorthand: true } }],
+        }),
+      );
+      const result = await execa("node", [astroCliPath, "--stdin-filepath=page.astro"], {
+        cwd: directory,
+        input: "<Card name={name} />",
+      });
+      expect(result.stdout).toBe("<Card {name} />");
+    } finally {
+      await rm(directory, { recursive: true, force: true });
+    }
+  });
