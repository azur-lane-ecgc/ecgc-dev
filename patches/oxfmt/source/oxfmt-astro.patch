diff --git a/apps/oxfmt/test/astro/fixtures/return/return-arrow-parens-avoid/input.astro b/apps/oxfmt/test/astro/fixtures/return/return-arrow-parens-avoid/input.astro
new file mode 100644
index 0000000000000000000000000000000000000000..4e4d62b4dd315170a0cd9026444691e92af594f9
--- /dev/null
+++ b/apps/oxfmt/test/astro/fixtures/return/return-arrow-parens-avoid/input.astro
@@ -0,0 +1,29 @@
+---
+// Test 1: we can use the word return in a comment without problems
+  // return "return" 'return' ;return
+
+// Test 2: we can use return in an import
+  import _return from 'return'
+
+// Test 3: we can use return in a function
+  function t() {
+    ;return "return"
+  }
+
+// Test 4: we can use return in a block
+  if (false) {
+    return 'return';
+  }
+
+// Test 5: we can use return outside a block
+  return `return`
+
+// Test 6: we can return multiple things
+  return 1, 2 as const
+
+// Test 7: we can return inline
+	if (Astro.cookies.get("token").value) return Astro.redirect("/");
+---
+
