+/// Inject Astro plugin options while preserving the original printer defaults.
+pub fn inject_astro_plugin_payload(opts: &mut Value, config: &FormatConfig) {
+    let map = as_object_mut(opts);
+    map.insert("_useAstroPlugin".to_string(), Value::Bool(true));
+    if config.sort_imports.is_some() {
+        map.insert("_sortAstroImports".to_string(), Value::Bool(true));
+    }
+    if let Some(value) = config.astro_allow_shorthand {
+        map.insert("astroAllowShorthand".to_string(), Value::Bool(value));
+    }
+    if let Some(value) = config.astro_skip_frontmatter {
+        map.insert("astroSkipFrontmatter".to_string(), Value::Bool(value));
+    }
+    if let Some(value) = config.astro_compress_html {
+        let mode = match value {
+            AstroCompressHtmlConfig::Mode(AstroWhitespaceMode::Jsx) => "jsx",
+            AstroCompressHtmlConfig::Mode(AstroWhitespaceMode::Html)
+            | AstroCompressHtmlConfig::Bool(true) => "html",
+            AstroCompressHtmlConfig::Mode(AstroWhitespaceMode::None)
+            | AstroCompressHtmlConfig::Bool(false) => "none",
+        };
+        map.insert("astroCompressHTML".to_string(), Value::from(mode));
+    }
+}
