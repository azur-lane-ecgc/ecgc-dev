--- /dev/null
+++ b/apps/oxfmt/test/lsp/astro/astro.test.ts
@@ -0,0 +1,22 @@
+import { join } from "node:path";
+import { pathToFileURL } from "node:url";
+import { TextDocument } from "vscode-languageserver-textdocument";
+import { describe, expect, it } from "vitest";
+import { createLspConnection } from "../utils";
+
+describe("Astro editor formatting", () => {
+  it.each(["file", "untitled"])("formats an unsaved %s Astro document", async (scheme) => {
+    await using client = createLspConnection();
+    await client.initialize(null);
+    const uri =
+      scheme === "file"
+        ? pathToFileURL(join(import.meta.dirname, "page.astro")).href
+        : "untitled:Astro-1";
+    const source = '<div   class = "x">Hello</div>';
+    await client.didOpen(uri, "astro", source);
+    const edits = await client.format(uri);
+    expect(edits).not.toBeNull();
+    const document = TextDocument.create(uri, "astro", 1, source);
+    expect(TextDocument.applyEdits(document, edits!)).toBe('<div class="x">Hello</div>\n');
+  });
+});
