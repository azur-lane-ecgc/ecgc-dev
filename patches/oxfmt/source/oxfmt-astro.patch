+import { existsSync, readFileSync, readdirSync } from "node:fs";
+import { join, relative } from "node:path";
+import { describe, expect, it } from "vitest";
+import { format } from "../../dist/index.js";
+import type { FormatConfig } from "../../dist/index.js";
+
+const astroFixtures = join(import.meta.dirname, "../astro/fixtures");
+
+describe("Astro formatting", () => {
+  it("formats complete Astro files without enabling a plugin in config", async () => {
+    const source = `---
+const title='Hello'
+---
+<h1 class = "heading">{ title }</h1>
+<script>const count=1</script>
+<style>.heading{color:red}</style>`;
+    const result = await format("page.astro", source);
+    expect(result.errors).toStrictEqual([]);
+    expect(result.code).toBe(`---
+const title = "Hello";
+---
+
+<h1 class="heading">{title}</h1>
+<script>
+  const count = 1;
+</script>
+<style>
+  .heading {
+    color: red;
+  }
+</style>
+`);
+  });
+
+  it("formats template-only files", async () => {
+    const result = await format("page.astro", '<div   class = "x">Hello</div>');
+    expect(result.errors).toStrictEqual([]);
+    expect(result.code).toBe('<div class="x">Hello</div>\n');
+  });
+
+  it("sorts Astro imports alongside the Tailwind plugin", async () => {
+    const source = `---
+import Widget from "./Widget.astro";
+import { helper } from "./helper";
+import BaseLayout from "../layouts/BaseLayout.astro";
+---
+<BaseLayout><Widget>{helper()}</Widget></BaseLayout>
+<div class="px-4 flex mt-2">Hello</div>
+`;
+    const result = await format("page.astro", source, {
+      sortImports: true,
+      sortTailwindcss: true,
+    });
+    expect(result.errors).toStrictEqual([]);
+    expect(result.code).toBe(`---
+import BaseLayout from "../layouts/BaseLayout.astro";
+import Widget from "./Widget.astro";
+import { helper } from "./helper";
+---
+
+<BaseLayout>
+  <Widget>{helper()}</Widget>
+</BaseLayout>
+<div class="px-4 flex mt-2">Hello</div>
+`);
+    const options = { sortImports: true, sortTailwindcss: true };
+    expect((await format("page.astro", result.code, options)).code).toBe(result.code);
+  });
+
+
+  it("handles Unicode, tabs, and CRLF without changing content", async () => {
+    const source = `---\r\nconst title='😀 café'\r\n---\r\n<section><h1>{ title }</h1></section>`;
+    const options: FormatConfig = { useTabs: true, endOfLine: "crlf", singleQuote: true };
+    const result = await format("unicode.astro", source, options);
+    expect(result.errors).toStrictEqual([]);
+    expect(result.code).toContain("'😀 café'");
+    expect(result.code).toContain("\t<h1>{title}</h1>");
+    expect(result.code.replaceAll("\r\n", "")).not.toContain("\n");
+    expect((await format("unicode.astro", result.code, options)).code).toBe(result.code);
+  });
+
+  it.each([
+    [true, "html"],
+    [false, "none"],
+  ] as const)("maps astroCompressHTML %s to %s", async (value, mode) => {
+    const source = "<div>   <span>Hello</span>   </div>";
+    const booleanResult = await format("page.astro", source, { astroCompressHTML: value });
+    const stringResult = await format("page.astro", source, { astroCompressHTML: mode });
+    expect(booleanResult.errors).toStrictEqual([]);
+    expect(stringResult.errors).toStrictEqual([]);
+    expect(booleanResult.code).toBe(stringResult.code);
+  });
+
+  it("formats Astro fences in Markdown", async () => {
+    const result = await format("guide.md", '```astro\n<div   class = "x">Hello</div>\n```\n');
+    expect(result.errors).toStrictEqual([]);
+    expect(result.code).toBe('```astro\n<div class="x">Hello</div>\n```\n');
+  });
+
+  it("retains Astro fences when embedded formatting is off", async () => {
+    const source = '```astro\n<div   class = "x">Hello</div>\n```\n';
+    const result = await format("guide.md", source, { embeddedLanguageFormatting: "off" });
+    expect(result.errors).toStrictEqual([]);
+    expect(result.code).toBe(source);
+  });
+
+  for (const entry of readdirSync(astroFixtures, { recursive: true, withFileTypes: true })) {
+    if (entry.name !== "input.astro") continue;
+    const fixtureDirectory = entry.parentPath;
+    // This fixture loads an extra custom Prettier plugin, which oxfmt does not expose.
+    if (existsSync(join(fixtureDirectory, "options.js"))) continue;
+    const optionsPath = join(fixtureDirectory, "options.json");
+    const options: FormatConfig = existsSync(optionsPath)
+      ? JSON.parse(readFileSync(optionsPath, "utf8"))
+      : {};
+
+    it(`matches Astro upstream output: ${relative(astroFixtures, fixtureDirectory)}`, async () => {
+      const source = readFileSync(join(fixtureDirectory, "input.astro"), "utf8");
+      const expected = readFileSync(join(fixtureDirectory, "output.astro"), "utf8");
+      const filepath = join(fixtureDirectory, "input.astro");
+      const result = await format(filepath, source, { printWidth: 80, ...options });
+      expect(result.errors).toStrictEqual([]);
+      expect(result.code).toBe(expected);
+      const secondPass = await format(filepath, result.code, { printWidth: 80, ...options });
+      expect(secondPass.errors).toStrictEqual([]);
+      expect(secondPass.code).toBe(result.code);
+    });
+  }
+
+  for (const entry of readdirSync(join(astroFixtures, "errors"))) {
+    if (!entry.endsWith(".astro")) continue;
+    it(`reports invalid Astro syntax: ${entry}`, async () => {
+      const source = readFileSync(join(astroFixtures, "errors", entry), "utf8");
+      const result = await format(entry, source);
+      expect(result.errors.length).toBeGreaterThan(0);
+      expect(result.code).toBe(source);
+    });
+  }
+});
