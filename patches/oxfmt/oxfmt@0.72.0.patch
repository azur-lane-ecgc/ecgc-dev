@@ -1,3 +1,12 @@
 #!/usr/bin/env node
 
-import "../dist/cli.js";
+import { runAstroCli } from "../dist/astro-cli.js";
+
+const astroResult = await runAstroCli();
+if (astroResult.needsNativeCli) {
+  const nativeCli = await import("../dist/cli.js");
+  await nativeCli.cliComplete;
+  process.exitCode = astroResult.exitCode || process.exitCode;
+} else if (astroResult.handled) {
+  process.exitCode = astroResult.exitCode;
+}
