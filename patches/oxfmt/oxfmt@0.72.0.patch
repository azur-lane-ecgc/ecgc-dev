diff --git a/node_modules/oxfmt/dist/astro-cli.js b/dist/astro-cli.js
new file mode 100644
index 0000000000000000000000000000000000000000..27bddb4e647b44d11b21277c20cea8e98fe3a4d9
--- /dev/null
+++ b/dist/astro-cli.js
@@ -0,0 +1,355 @@
+import { globSync, readFileSync, statSync, writeFileSync } from "node:fs"
+import { dirname, join, resolve } from "node:path"
+import { pathToFileURL } from "node:url"
+import { formatAstro } from "./astro-format.js"
+
+const optionValues = new Map([
+  ["-c", "config"],
+  ["--config", "config"],
+  ["--ignore-path", "ignorePath"],
+  ["--stdin-filepath", "stdinFilepath"],
+  ["--threads", "threads"],
+])
+
+const specialModes = new Set([
+  "--help",
+  "-h",
+  "--version",
+  "-V",
+  "--init",
+  "--lsp",
+  "--migrate",
+])
+
+/** Run Astro formatting before the stock native oxfmt CLI. */
+export const runAstroCli = async () => {
+  const cwd = process.cwd()
+  const args = process.argv.slice(2)
+  if (args.some((arg) => specialModes.has(arg.split("=", 1)[0]))) {
+    return { handled: false, needsNativeCli: true, exitCode: 0 }
+  }
+
+  const parsed = parseArguments(args)
+  const config = await loadOxfmtConfig(parsed.config, cwd)
+  if (parsed.stdinFilepath?.endsWith(".astro")) {
+    const exitCode = await formatStdin(
+      parsed.stdinFilepath,
+      await readStdin(),
+      config,
+    )
+    return { handled: true, needsNativeCli: false, exitCode }
+  }
+
+  const astroFiles = discoverAstroFiles(parsed.targets, cwd, config)
+  if (astroFiles.length === 0) {
+    return { handled: false, needsNativeCli: true, exitCode: 0 }
+  }
+
+  const astroExitCode = await formatAstroFiles(
+    astroFiles,
+    config,
+    parsed.mode,
+    cwd,
+  )
+
+  return {
+    handled: true,
+    needsNativeCli: hasNonAstroTargets(parsed.targets, cwd),
+    exitCode: astroExitCode,
+  }
+}
+
+const parseArguments = (args) => {
+  const parsed = { mode: "write", targets: [] }
+
+  for (let index = 0; index < args.length; index += 1) {
+    const arg = args[index]
+    if (arg === "--check") {
+      parsed.mode = "check"
+      continue
+    }
+    if (arg === "--list-different") {
+      parsed.mode = "list"
+      continue
+    }
+    if (arg === "--write") {
+      parsed.mode = "write"
+      continue
+    }
+
+    const equalsIndex = arg.indexOf("=")
+    const name = equalsIndex === -1 ? arg : arg.slice(0, equalsIndex)
+    const optionName = optionValues.get(name)
+    if (!optionName) {
+      if (!name.startsWith("-") || name.startsWith("!")) {
+        parsed.targets.push(arg)
+      }
+      continue
+    }
+
+    parsed[optionName] =
+      equalsIndex === -1 ? args[index + 1] : arg.slice(equalsIndex + 1)
+    if (equalsIndex === -1) {
+      index += 1
+    }
+  }
+
+  return parsed
+}
+
+const discoverAstroFiles = (targets, cwd, config) => {
+  const positiveTargets = targets.length === 0 ? ["."] : targets.filter(Boolean)
+  const exclude = buildExcludePatterns(targets, config)
+  const files = new Set()
