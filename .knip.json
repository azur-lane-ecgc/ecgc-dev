{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/web": {
      "entry": [
        "src/pages/**/*.astro",
        "src/pages/**/*.ts",
        "cloudflare.config.ts",
        "wrangler.config.ts"
      ],
      "project": ["**/*"]
    },
    "packages/dev": {
      "project": ["**/*"]
    },
    "packages/gsheets2img": {
      "project": ["**/*"]
    },
    "packages/compress": {
      "project": ["**/*"]
    },
    "packages/image-downloader": {
      "project": ["**/*"]
    }
  },
  "ignoreWorkspaces": ["packages/AzurLaneData"]
}
