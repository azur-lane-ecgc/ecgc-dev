{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "apps/web": {
      "entry": [
        "src/pages/**/*.astro",
        "src/pages/**/*.ts",
        "src/**/*.test.ts"
      ],
      "project": ["**/*"]
    },
    "packages/dev": {
      "entry": ["src/**/*.test.ts"],
      "project": ["**/*"]
    },
    "packages/gsheets2img": {
      "entry": ["src/**/*.test.ts"],
      "project": ["**/*"]
    },
    "packages/compress": {
      "entry": ["src/**/*.test.ts"],
      "project": ["**/*"]
    },
    "packages/image-downloader": {
      "entry": ["src/**/*.test.ts"],
      "project": ["**/*"]
    },
    "packages/worker": {
      "entry": ["cloudflare.config.ts", "wrangler.config.ts"]
    }
  },
  "ignoreWorkspaces": ["packages/AzurLaneData"]
}
