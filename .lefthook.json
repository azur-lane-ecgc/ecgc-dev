{
  "pre-commit": {
    "parallel": false,
    "commands": {
      "knip": {
        "glob": [
          "packages/dev/**/*.{astro,html,md,ts,tsx,json,css}",
          "apps/web/**/*.{astro,html,md,ts,tsx,json,css}",
          "packages/gsheets2img/**/*.{astro,html,md,ts,tsx,json,css}"
        ],
        "run": "bun knip --fix"
      },
      "oxlint": {
        "glob": [
          "packages/dev/**/*.{astro,html,md,ts,tsx,json,css}",
          "apps/web/**/*.{astro,html,md,ts,tsx,json,css}",
          "packages/gsheets2img/**/*.{astro,html,md,ts,tsx,json,css}"
        ],
        "run": "bunx --bun oxlint --fix {staged_files}",
        "stage_fixed": true
      },
      "prettier": {
        "glob": [
          "packages/dev/**/*.{astro,html,md,ts,tsx,json,css}",
          "apps/web/**/*.{astro,html,md,ts,tsx,json,css}",
          "packages/gsheets2img/**/*.{astro,html,md,ts,tsx,json,css}"
        ],
        "run": "bunx --bun prettier --write {staged_files}",
        "stage_fixed": true
      }
    }
  }
}
