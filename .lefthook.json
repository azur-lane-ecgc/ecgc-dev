{
  "pre-commit": {
    "parallel": false,
    "commands": {
      "knip": {
        "glob": [
          "packages/dev/**/*.{astro,html,md,ts,tsx,json,css}",
          "apps/web/**/*.{astro,html,md,ts,tsx,json,css}",
          "packages/gsheets2img/**/*.{astro,html,md,ts,tsx,json,css}",
          "packages/compress/**/*.{astro,html,md,ts,tsx,json,css}",
          "packages/image-downloader/**/*.{astro,html,md,ts,tsx,json,css}"
        ],
        "run": "bun knip --fix"
      },
      "oxlint": {
        "glob": ["**/*.{js,jsx,ts,tsx}"],
        "run": "bunx --bun oxlint --fix {staged_files}",
        "stage_fixed": true
      },
      "oxfmt": {
        "glob": [
          "packages/dev/**/*.{astro,html,md,ts,tsx,json,css}",
          "apps/web/**/*.{astro,html,md,ts,tsx,json,css}",
          "packages/gsheets2img/**/*.{astro,html,md,ts,tsx,json,css}",
          "packages/compress/**/*.{astro,html,md,ts,tsx,json,css}",
          "packages/image-downloader/**/*.{astro,html,md,ts,tsx,json,css}",
          "patches/oxfmt/**/*.{astro,html,md,ts,tsx,json,css}"
        ],
        "run": "bunx oxfmt --write {staged_files}",
        "stage_fixed": true
      }
    }
  }
}
