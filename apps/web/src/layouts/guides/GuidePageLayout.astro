---
import { ClientRouter } from "astro:transitions"

import imageMiscNoCover from "@/assets/misc/no_cover.jpg"
import imageMiscSiteIconIco from "@/assets/misc/SiteIcon.ico"
import imageMiscSiteIcon from "@/assets/misc/SiteIcon.png"
// components
import Footer from "@/components/_common/Footer.astro"

// user style sheets
import "@/styles/guide_page.css"

import { Navbar } from "@/components/_common/Navbar"
import { SidenavPage } from "@/components/_common/Sidenav"
import { pageInfo } from "@/constants/index"
import { getImageAssetUrl } from "@/utils/images/imageAssetUrl"

interface Props {
  title: string
  metaTitle?: string
  activePage: string
  canonical?: string
  tocID?: string | null
  metaUrl?: string
  metaImage?: string
  metaDescription: string
}

const {
  title,
  metaTitle,
  activePage,
  canonical,
  tocID,
  metaUrl,
  metaImage,
  metaDescription,
} = Astro.props
---

<!doctype html>
<html lang="en">
  <head>
    <!-- for google search -->
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link
      rel="canonical"
      href={`https://azurlaneecgc.com${activePage ? `/${canonical ?? activePage}` : ""}`}
    />

    <meta
      name="keywords"
      content="English Community Guide Compendium, English Azur Lane, Azur, Lane, Azur Lane, ECGC, Azur Lane ECGC, Wiki, Guide, Guides, Help, Tool, Tools, Ship, Ships, Gear, Gears, Samheart564, Sam Heart, Sam"
    />

    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{metaTitle || title} - ECGC</title>

    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebSite",
        name: "Azur Lane ECGC",
        url: "https://azurlaneecgc.com/",
        image: new URL(imageMiscSiteIcon.src, "https://azurlaneecgc.com").href,
      })}
    />
    <meta name="description" content={metaDescription} />
    <meta property="og:title" content={title} />
    <meta property="og:type" content="website" />
    <meta
      property="og:url"
      content={`https://azurlaneecgc.com/${metaUrl ? `/${metaUrl}` : ""}`}
    />
    <meta
      property="og:image"
      content={
        new URL(
          metaImage
            ? getImageAssetUrl(metaImage)
            : pageInfo.find((page) => page.title === title)?.image.src ||
                imageMiscNoCover.src,
          "https://azurlaneecgc.com",
        ).href
      }
    />
    <meta property="og:description" content={metaDescription} />

    <link rel="icon" type="image/x-icon" href={imageMiscSiteIconIco} />
  </head>
  <span data-astro-transition-persist="someId">
    <noscript>Your browser does not support JavaScript!</noscript>
  </span>

  <ClientRouter />

  <body>
    <Navbar activePage={activePage} client:load />
    {!!tocID && <SidenavPage page={tocID} client:load />}
    <div
      id="main"
      class="guide-content-body custom-sidenav-shift mx-auto max-w-full overflow-y-hidden px-3 md:max-w-[75%]"
    >
      <slot />
    </div>
  </body>
  <Footer />

  <style is:global>
    @media screen and (min-width: 1016px) and (max-width: 2016px) {
      .custom-sidenav-shift {
        margin-left: 250px;
        transition: 0.5s;
      }

      .custom-sidenav-shift.custom-sidenav-collapse {
        margin-left: 12.5vw;
      }
    }
  </style>
</html>
