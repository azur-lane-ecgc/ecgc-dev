---
const changelogUrl = "changelog"
const contributorsUrl = "contributors"
const discordUrl = "https://discord.gg/wKJKxq5WQt"

const buttonStyle =
  "homepage-button flex items-center justify-center w-full py-[10px] text-lg border rounded-lg transition-all duration-150 ease-in-out no-underline cursor-pointer"
---

<style>
  :root {
    --button-border: #0d63fe;
    --button-shadow: #094bb8;
  }

  .homepage-button {
    background-color: transparent;
    border-color: var(--button-border);
    color: pink;
    font-weight: 700;
    letter-spacing: 0.5px;
    box-shadow: 0px 4px var(--button-shadow);
    transform: translateY(-4px);
  }

  .homepage-button:visited {
    background-color: transparent;
    border-color: var(--button-border);
    color: orange;
  }

  .homepage-button:hover {
    background-color: #0d63fe;
    border-color: limegreen;
    color: cyan;
    text-decoration: underline;
  }

  .homepage-button:active {
    box-shadow: 0px 0px var(--button-shadow);
    transform: translateY(0px);
    animation: buttonClicked 0.15s;
  }

  @keyframes buttonClicked {
    0% {
      transform: translateY(-4px);
      box-shadow: 0px 4px var(--button-shadow);
    }
    100% {
      transform: translateY(0px);
      box-shadow: 0px 0px var(--button-shadow);
    }
  }
</style>

<div class="flex flex-col justify-center md:flex-row md:gap-5">
  <div class="mb-3 flex w-full justify-center md:w-1/3">
    <a
      class={buttonStyle}
      href={changelogUrl}
      target="_self"
      rel="noopener noreferrer"
    >
      <b class="text-xl lg:text-2xl">
        <i class="fa fa-clock-rotate-left nav-logo-custom"></i> Changelog
      </b>
    </a>
  </div>
  <div class="mb-3 flex w-full justify-center md:w-1/3">
    <a
      class={buttonStyle}
      href={contributorsUrl}
      target="_self"
      rel="noopener noreferrer"
    >
      <b class="text-xl lg:text-2xl">
        <i class="fa fa-user-pen nav-logo-custom"></i> Contributors
      </b>
    </a>
  </div>
  <div class="mb-3 flex w-full justify-center md:w-1/3">
    <a
      class={buttonStyle}
      href={discordUrl}
      target="_blank"
      rel="noopener noreferrer"
    >
      <b class="text-xl lg:text-2xl">
        <i class="fa-brands fa-discord nav-logo-custom"></i> Discord
      </b>
    </a>
  </div>
</div>
