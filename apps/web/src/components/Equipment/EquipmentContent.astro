import EquipmentLinkButtons from "./EquipmentLinkButtons.astro"
---

<h2 id="introduction">Introduction</h2>
<HR />
<p>
  This guide gives a comprehensive overview of the best equipment in Azur Lane!
</p>
<br />

<h4>Notes:</h4>
<ul>
  <li>
    <p>You can click on an image to open it in a new tab.</p>
  </li>
  <li>
    <p>
      If the images are not loading, click the 'Spreadsheet' link below to open
      a Google Sheets version of this page.
    </p>
  </li>
  <li>
    <p>
      For a less comprehensive but simpler gear guide, you can read Suchiguma's
      Quick Gear Guide linked below.
    </p>
  </li>
</ul>
<br />

<EquipmentLinkButtons />
<br />

<h2 id="legend">Legend</h2>
<HR />

<h3 id="ship_types">Ship Type Abbreviations</h3>
<a
  rel="noopener noreferrer"
  target="_blank"
  href={imageEquipMiscShipTypeAbbrev.src}
  title="Ship Type Abbreviations"
>
  <Image
    loading="lazy"
    class="equip-misc-img"
    src={imageEquipMiscShipTypeAbbrev}
    alt="Ship Type Abbrev."
  />
</a>
<br />
<br />

