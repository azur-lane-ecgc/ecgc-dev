{
  "name": "ecgc-dev",
  "private": true,
  "workspaces": [
    "packages/dev",
    "apps/web",
    "packages/gsheets2img",
    "packages/compress",
    "packages/image-downloader"
  ],
  "scripts": {
    "prepare": "bunx lefthook install",
    "update": "bun update --recursive",
    "rebuild": "rm -rf node_modules && rm -rf .wrangler && rm -rf packages/AzurLaneData && rm -rf apps/web/node_modules && rm -rf packages/dev/node_modules && rm -rf packages/gsheets2img/node_modules && rm -rf packages/compress/node_modules && rm -rf packages/image-downloader/node_modules && rm -rf apps/web/dist && rm -rf apps/web/.astro && bun run update",
    "reset": "bun run rebuild && bun run devtools && bun run build",
    "submodule": "git submodule update --recursive --remote",
    "gsheets2img": "bun --filter gsheets2img main",
    "plan-ship-icons": "bun --filter image-downloader plan",
    "download-ship-icons": "bun --filter image-downloader download",
    "compress": "bun --filter compress compress",
    "smol-format": "bunx oxfmt --write \"packages/**/*.{astro,json}\" \"apps/**/*.{astro,json}\"",
    "format": "bunx oxfmt --write packages apps patches",
    "format:check": "bunx oxfmt --check packages apps patches",
    "lint": "bunx --bun oxlint --fix packages apps patches",
    "devtools": "bun run submodule && bun --filter dev main && bun run format",
    "build": "bun --filter frontend build",
    "check": "bun --filter frontend check && bun --filter dev check && bun --filter gsheets2img check && bun --filter compress check && bun --filter image-downloader check",
    "cf-build": "bun run build && bun run compress",
    "dev": "bun --filter frontend dev",
    "cf-dev": "bunx wrangler dev",
    "start": "NODE_ENV=PRODUCTION bun --filter frontend preview",
    "deploy": "bun run cf-build && bunx wrangler deploy"
  },
  "devDependencies": {
    "@astrojs/compiler-rs": "0.4.0",
    "knip": "^6.39.0",
    "lefthook": "^2.1.16",
    "oxlint": "^1.86.0",
    "oxfmt": "0.72.0",
    "typescript": "^6.0.3",
    "wrangler": "^4.147.0"
  },
  "optionalDependencies": {
    "@oxfmt/binding-darwin-arm64": "0.72.0",
    "@oxfmt/binding-darwin-x64": "0.72.0",
    "@oxfmt/binding-linux-arm64-gnu": "0.72.0",
    "@oxfmt/binding-linux-arm64-musl": "0.72.0",
    "@oxfmt/binding-linux-arm-gnueabihf": "0.72.0",
    "@oxfmt/binding-linux-arm-musleabihf": "0.72.0",
    "@oxfmt/binding-linux-x64-gnu": "0.72.0",
    "@oxfmt/binding-linux-x64-musl": "0.72.0",
    "@oxfmt/binding-linux-ppc64-gnu": "0.72.0",
    "@oxfmt/binding-linux-riscv64-gnu": "0.72.0",
    "@oxfmt/binding-linux-riscv64-musl": "0.72.0",
    "@oxfmt/binding-linux-s390x-gnu": "0.72.0",
    "@oxfmt/binding-win32-arm64-msvc": "0.72.0",
    "@oxfmt/binding-win32-ia32-msvc": "0.72.0",
    "@oxfmt/binding-win32-x64-msvc": "0.72.0",
    "@oxfmt/binding-freebsd-x64": "0.72.0",
    "@oxfmt/binding-android-arm64": "0.72.0",
    "@oxfmt/binding-android-arm-eabi": "0.72.0",
    "@oxfmt/binding-openharmony-arm64": "0.72.0"
  },
  "trustedDependencies": [
    "agent-browser",
    "@tailwindcss/oxide",
    "esbuild",
    "gsheets2img",
    "lefthook",
    "oxc-resolver",
    "sharp",
    "workerd"
  ],
  "packageManager": "bun@1.4.2",
  "engines": {
    "node": ">=22.12.0",
    "bun": ">=1.4.2"
  },
  "patchedDependencies": {
    "oxfmt@0.72.0": "patches/oxfmt/oxfmt@0.72.0.patch"
  }
}
