{
  "name": "ecgc-dev",
  "private": true,
  "scripts": {
    "prepare": "pnpm exec lefthook install",
    "update": "pnpm --recursive update",
    "rebuild": "pnpm install --force",
    "reset": "pnpm run rebuild && pnpm run devtools && pnpm run build",
    "submodule": "git submodule update --recursive --remote",
    "gsheets2img": "pnpm --filter gsheets2img browser && pnpm --filter gsheets2img main",
    "compress": "pnpm --filter compress compress",
    "smol-format": "pnpm exec prettier --write \"packages/**/*.{astro,json}\" \"apps/**/*.{astro,json}\"",
    "format": "pnpm exec prettier --write \"packages/**/*.{astro,html,md,ts,tsx,json,css}\" \"apps/**/*.{astro,html,md,ts,tsx,json,css}\"",
    "lint": "pnpm exec oxlint --fix packages apps",
    "devtools": "pnpm run submodule && pnpm --filter dev main && pnpm run format",
    "build": "pnpm --filter frontend build",
    "check": "pnpm --filter frontend check && pnpm --filter dev check && pnpm --filter gsheets2img check && pnpm --filter compress check",
    "cf-build": "pnpm run build && pnpm run compress",
    "dev": "pnpm --filter frontend dev",
    "cf-dev": "pnpm exec wrangler dev",
    "start": "NODE_ENV=PRODUCTION pnpm --filter frontend preview",
    "deploy": "pnpm run cf-build && pnpm exec wrangler deploy"
  },
  "devDependencies": {
    "@prettier/plugin-oxc": "^0.2.3",
    "knip": "^6.39.0",
    "lefthook": "^2.1.16",
    "oxlint": "^1.86.0",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^1.1.0",
    "prettier-plugin-astro-organize-imports": "^0.4.14",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "wrangler": "^4.147.0"
  },
  "packageManager": "pnpm@12.9.1",
  "engines": {
    "node": ">=22.12.0"
  }
}
